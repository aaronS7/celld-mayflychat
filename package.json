{
  "name": "mayfly-celld",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node celld/generate.mjs",
    "check": "node celld/generate.mjs --check && tsc",
    "predev": "npm run generate",
    "dev": "CELLD_FETCH_TIMEOUT_S=86500 CELLD_HANDLER_BUDGET_S=86500 celld dev .",
    "predeploy": "npm run generate && tsc",
    "deploy": "celld deploy .",
    "test": "npm run check && node celld/check.mjs && npm run test:settings && npm run test:policy && npm run test:moderation",
    "test:settings": "node --test celld/configuration.test.mjs",
    "test:policy": "node --test celld/policy.test.mjs",
    "test:protocol": "node --test celld/protocol.test.mjs",
    "test:hosting": "node --test celld/hosting.test.mjs",
    "fleet:up": "node celld/fleet.mjs up",
    "prefleet:deploy": "npm run generate && tsc",
    "fleet:deploy": "node celld/fleet.mjs deploy",
    "fleet:status": "node celld/fleet.mjs status",
    "fleet:down": "node celld/fleet.mjs down",
    "fleet:https": "node celld/fleet-https.mjs up",
    "test:fleet": "node celld/fleet.test.mjs",
    "test:ingress": "node celld/ingress.test.mjs",
    "test:moderation": "node --test --test-concurrency=1 celld/moderation.test.mjs celld/moderation-runtime.test.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "typescript": "7.0.2"
  }
}
